// fastfetch config template — rendered to ~/.config/fastfetch/config.jsonc
// by dotfiles-apply-colors. @...@ placeholders become "r;g;b" values read
// from the active kitty theme: ACCENT / ON_CHIP = accent / bright accent,
// CHIP = accent blended into the background (Material tonal container),
// FG / MUTED = foreground / dimmed foreground. @LOGO@ becomes the rendered
// logo.png tile, or the built-in small Arch logo if rsvg-convert is missing.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": @LOGO@,
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;@ACCENT@",
            "output": "38;2;@FG@"
        },
        "constants": [
            "──────────────────────────────"
        ]
    },
    "modules": [
        {
            "type": "title",
            "format": "{#1;38;2;@ACCENT@}{user-name}{#}{#38;2;@MUTED@} at {#}{#1;38;2;@FG@}{host-name}{#}"
        },
        {
            "type": "custom",
            "format": "{#38;2;@MUTED@}{$1}{#}"
        },
        {
            "type": "custom",
            "format": "{#1;38;2;@ACCENT@}System{#}"
        },
        {
            "type": "os",
            "key": "{#38;2;@CHIP@}{#48;2;@CHIP@;38;2;@ON_CHIP@} {icon} {#}{#38;2;@CHIP@}{#}",
            "format": "{pretty-name}"
        },
        {
            "type": "kernel",
            "key": "{#38;2;@CHIP@}{#48;2;@CHIP@;38;2;@ON_CHIP@} 󰌢 {#}{#38;2;@CHIP@}{#}"
        },
        {
            "type": "uptime",
            "key": "{#38;2;@CHIP@}{#48;2;@CHIP@;38;2;@ON_CHIP@} 󰅐 {#}{#38;2;@CHIP@}{#}"
        },
        {
            "type": "packages",
            "key": "{#38;2;@CHIP@}{#48;2;@CHIP@;38;2;@ON_CHIP@} 󰏖 {#}{#38;2;@CHIP@}{#}"
        },
        {
            "type": "wm",
            "key": "{#38;2;@CHIP@}{#48;2;@CHIP@;38;2;@ON_CHIP@} 󰖭 {#}{#38;2;@CHIP@}{#}"
        },
        {
            "type": "shell",
            "key": "{#38;2;@CHIP@}{#48;2;@CHIP@;38;2;@ON_CHIP@}  {#}{#38;2;@CHIP@}{#}"
        },
        {
            "type": "terminal",
            "key": "{#38;2;@CHIP@}{#48;2;@CHIP@;38;2;@ON_CHIP@}  {#}{#38;2;@CHIP@}{#}"
        },
        "break",
        {
            "type": "custom",
            "format": "{#1;38;2;@ACCENT@}Hardware{#}"
        },
        {
            "type": "cpu",
            "key": "{#38;2;@CHIP@}{#48;2;@CHIP@;38;2;@ON_CHIP@} 󰻠 {#}{#38;2;@CHIP@}{#}",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "{#38;2;@CHIP@}{#48;2;@CHIP@;38;2;@ON_CHIP@} 󰍛 {#}{#38;2;@CHIP@}{#}",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "{#38;2;@CHIP@}{#48;2;@CHIP@;38;2;@ON_CHIP@} 󰘚 {#}{#38;2;@CHIP@}{#}"
        },
        {
            "type": "disk",
            "key": "{#38;2;@CHIP@}{#48;2;@CHIP@;38;2;@ON_CHIP@} 󰋊 {#}{#38;2;@CHIP@}{#}",
            "folders": "/"
        },
        {
            "type": "battery",
            "key": "{#38;2;@CHIP@}{#48;2;@CHIP@;38;2;@ON_CHIP@} 󰁹 {#}{#38;2;@CHIP@}{#}"
        },
        {
            "type": "localip",
            "key": "{#38;2;@CHIP@}{#48;2;@CHIP@;38;2;@ON_CHIP@} 󰩟 {#}{#38;2;@CHIP@}{#}",
            "compact": true
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
