// Graphite Emerald fastfetch config
// Monochrome graphite/gray box, emerald green accent — matches
// kitty/themes/graphite-emerald.conf and scripts/tide/graphite-emerald.fish
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": {
            "1": "#34D399",
            "2": "#8A8F99"
        },
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "#34D399",
            "output": "#D6D9DE"
        },
        "constants": [
            "───────────────────────"
        ]
    },
    "modules": [
        {
            "type": "custom",
            "format": "┌{$1}┐",
            "outputColor": "#565A66"
        },
        {
            "type": "title",
            "key": "│ 󰀄",
            "keyColor": "#34D399",
            "format": "{user-name}@{host-name}"
        },
        {
            "type": "os",
            "key": "│ {icon}",
            "keyColor": "#34D399"
        },
        {
            "type": "kernel",
            "key": "│ 󰌢",
            "keyColor": "#34D399"
        },
        {
            "type": "uptime",
            "key": "│ 󰅐",
            "keyColor": "#34D399"
        },
        {
            "type": "packages",
            "key": "│ 󰏖",
            "keyColor": "#34D399"
        },
        {
            "type": "custom",
            "format": "├{$1}┤",
            "outputColor": "#565A66"
        },
        {
            "type": "shell",
            "key": "│ ",
            "keyColor": "#7DD3C0"
        },
        {
            "type": "terminal",
            "key": "│ ",
            "keyColor": "#7DD3C0"
        },
        {
            "type": "cpu",
            "key": "│ 󰻠",
            "keyColor": "#7DD3C0"
        },
        {
            "type": "gpu",
            "key": "│ 󰍛",
            "keyColor": "#7DD3C0"
        },
        {
            "type": "memory",
            "key": "│ 󰑭",
            "keyColor": "#7DD3C0"
        },
        {
            "type": "disk",
            "key": "│ 󰋊",
            "keyColor": "#7DD3C0"
        },
        {
            "type": "localip",
            "key": "│ 󰩟",
            "keyColor": "#7DD3C0",
            "compact": true
        },
        {
            "type": "custom",
            "format": "└{$1}┘",
            "outputColor": "#565A66"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
